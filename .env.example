# PIP Farming bot settings. Copy to .env and fill in. Never commit .env.
# Bot token from @BotFather (@PipFarmingResultsBot)
TELEGRAM_BOT_TOKEN=
# Telegram user ids that may use the bot and get the previews (Samanway, Johannes)
PIP_ONLY_IDS=111111111,222222222
# People the bot chats with like a human assistant (Johannes)
PIP_CHAT_IDS=222222222
# Key file + host of the allowlisted server that calls the Levels provider API
PIP_SSH_KEY=/Users/YOU/.ssh/LevelsNew2026.pem
PIP_SSH_HOST=ubuntu@your-allowlisted-server
# 1 = post the 3 daily posts on schedule without asking for approval
PIP_AUTO_POST=0
